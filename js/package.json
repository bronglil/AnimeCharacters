{
  "name": "anime-ascii",
  "version": "0.4.0",
  "description": "Image-to-ASCII with optional truecolor HTML/ANSI for anime-style sprites",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "anime-ascii": "./bin/anime-ascii.js"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "convert": "node ./bin/anime-ascii.js",
    "build:characters": "node ./scripts/build-character-designs.js",
    "gallery": "npx --yes serve .. -p 5173"
  },
  "keywords": [
    "ascii",
    "ascii-art",
    "image",
    "anime",
    "silhouette",
    "cli"
  ],
  "author": "sajid",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "jimp": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bronglil/AnimeCharacters.git",
    "directory": "js"
  }
}
